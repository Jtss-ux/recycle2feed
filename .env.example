# ==============================================================================
# ReCycle2Feed - Environment Configuration Template
# NOTE: Never commit sensitive credentials or secret keys to source control.
# ==============================================================================

# Operating Mode: 'SIMULATION' or 'AWS'
VITE_APP_MODE=SIMULATION

# Backend API Base URL (leave empty in SIMULATION mode to use local in-browser simulation,
# or point to your deployed AWS API Gateway endpoint e.g., https://xyz.execute-api.ap-south-1.amazonaws.com)
VITE_API_BASE_URL=http://localhost:4000

# Default Demo Machine ID
VITE_DEFAULT_MACHINE_ID=machine-demo-01

# AWS Deployment Configuration (Used by SAM CLI and Lambda deployment)
AWS_REGION=ap-south-1
DYNAMODB_TRANSACTIONS_TABLE=recycle2feed-transactions-prod
DYNAMODB_MACHINES_TABLE=recycle2feed-machines-prod
DYNAMODB_MAINTENANCE_TABLE=recycle2feed-maintenance-prod
